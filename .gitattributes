# MEGATRON is developed partly on Windows and deployed exclusively on Linux.
#
# That combination has a specific failure mode worth closing off now: a config
# or script committed with CRLF line endings is syntactically valid on the
# developer's box and broken on the target. A shell script fails with the
# opaque "\r: command not found"; an nftables or OpenSIPS config fails to parse
# with a line number and no useful explanation. Both cost an afternoon the
# first time and are entirely preventable.
#
# So: normalise everything to LF in the repository, and force LF in the working
# tree for the files that are executed on a Linux host regardless of what the
# developer's core.autocrlf says.

* text=auto eol=lf

# Files that are read by a Linux daemon or interpreter. These must be LF in the
# working tree too, not merely in the object store.
*.sh        text eol=lf
*.cfg       text eol=lf
*.nft       text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.list      text eol=lf

# Binary — never touch.
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.gpg       binary
*.jar       binary
*.zip       binary
*.gz        binary
