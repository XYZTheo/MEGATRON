# MEGATRON — non-secret configuration, rendered by deploy/install.sh.
#
# Secrets live in /etc/megatron/secrets.env (mode 0640, root:megatron) and are
# loaded separately. Nothing in THIS file is confidential, which is what makes
# it safe to read when something is wrong.

# The SIP realm. It is baked into every stored HA1, so changing it invalidates
# every customer's password. Read ONCE here and used by both the store and the
# credential exporter: reading it in two places let them diverge, and the
# symptom was a credential file that silently emptied itself.
MEGATRON_SIP_REALM=@DOMAIN@

MEGATRON_DB_URL=jdbc:sqlite:/var/lib/megatron/megatron.db

# Loopback. These services issue credentials and move balance; on a public
# interface either one is the whole business. Main.kt warns loudly if this is
# changed, and the installer checks it afterwards.
MEGATRON_PROVISIONING_HOST=127.0.0.1
MEGATRON_PROVISIONING_PORT=8081
MEGATRON_SWITCH_API_PORT=8082

# The credential file OpenSIPS reads, and how often it is rewritten.
#
# The interval bounds how long a NEW customer waits for a login and how long a
# CLOSED one keeps registering. Neither is a money question: the authorizer
# decides on every call whether an account may spend, live, and it does not
# read this file.
MEGATRON_SUBSCRIBER_FILE=/etc/opensips/dbtext/subscriber
MEGATRON_SUBSCRIBER_INTERVAL_SECONDS=15

# Where to tell the switch to re-read that file. WITHOUT THIS, writing the
# file changes nothing: db_text loads its tables once at startup, so a new
# customer could never register and a rotated password would leave the old one
# working indefinitely — silently, because the write succeeded.
MEGATRON_SWITCH_MI_URL=http://127.0.0.1:8888/mi

# Survives a bot restart, so Telegram does not redeliver the last batch. NOT
# the protection against double-processing — a durable per-message claim in
# the store is, and has to be, since a crash can land between handling an
# update and writing this file.
MEGATRON_BOT_OFFSET_FILE=/var/lib/megatron/telegram.offset
