[Unit]
Description=MEGATRON provisioning API
After=network-online.target 
Wants=network-online.target

[Service]
Type=simple
User=megatron
Group=megatron
EnvironmentFile=/etc/megatron/megatron.env
EnvironmentFile=/etc/megatron/secrets.env
ExecStart=@REPO@/provisioning/build/install/provisioning/bin/provisioning
Restart=always
RestartSec=5

# The database and the credential file are the only things this may write.
ReadWritePaths=/var/lib/megatron /etc/opensips/dbtext
# Hardening. These are cheap and they bound what a compromise of this service
# reaches -- which is the point of the whole project.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
